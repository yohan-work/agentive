{
  "name": "agent-archive",
  "version": "0.1.0",
  "private": true,
  "description": "A curated, open-source library of practical AI agents, prompts, runbooks, and install kits for Codex, Claude, and Cursor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yohan-work/agentive.git"
  },
  "bugs": {
    "url": "https://github.com/yohan-work/agentive/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "check:data": "node scripts/check-data.mjs",
    "start": "node scripts/preview.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "content": "node scripts/build-content.mjs",
    "schema": "node scripts/generate-schema.mjs",
    "prebuild": "npm run content",
    "pretypecheck": "npm run content",
    "pretest": "npm run content",
    "postbuild": "node scripts/write-404.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "yaml": "^2.9.1"
  }
}
